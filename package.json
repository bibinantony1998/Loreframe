{
  "name": "historical-documentary-generator-backend",
  "version": "1.0.0",
  "description": "Multi-agent AI workflow backend for historical documentary video generation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build --prefix ui",
    "setup": "node scripts/setup.mjs",
    "start": "npm run setup && npm run dev:all",
    "dev": "npm run dev:all",
    "dev:server": "node scripts/logStreamer.mjs server \"tsx watch src/index.ts\"",
    "dev:ui": "node scripts/logStreamer.mjs ui \"npm run dev --prefix ui\"",
    "dev:comfy": "node scripts/logStreamer.mjs comfy \"cd comfyui && venv/bin/python main.py --listen 127.0.0.1 --port 8188\"",
    "dev:all": "concurrently -n \"SERVER,UI,COMFY\" -c \"blue,green,magenta\" \"npm run dev:server\" \"npm run dev:ui\" \"npm run dev:comfy\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google-cloud/text-to-speech": "^5.8.0",
    "@langchain/core": "^0.3.38",
    "@langchain/google-genai": "^0.1.9",
    "@langchain/langgraph": "^0.2.45",
    "@langchain/ollama": "^0.1.6",
    "@prisma/client": "^6.3.0",
    "@types/ws": "^8.18.1",
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.5.0",
    "sharp": "^0.35.3",
    "ws": "^8.21.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.1",
    "concurrently": "^9.1.2",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
