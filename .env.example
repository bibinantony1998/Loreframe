PORT=3001
NODE_ENV=development
DATABASE_URL="file:./dev.db"
REDIS_HOST="localhost"
REDIS_PORT=6379
GOOGLE_API_KEY="your-gemini-api-key-here"
GOOGLE_API_KEY1="your-gemini-api-key-1-here"
GOOGLE_API_KEY2="your-gemini-api-key-2-here"
GEMINI_MODEL="gemini-2.5-pro"

# LLM Rate Limiting & Cooldown Configuration
LLM_BATCH_SIZE=5
LLM_COOLDOWN_MS=15000
LLM_CALL_DELAY_MS=3000
LLM_MAX_RETRIES=4
