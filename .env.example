PORT=3001
NODE_ENV=development
DATABASE_URL="file:./dev.db"
REDIS_HOST="localhost"
REDIS_PORT=6379

#Optional if you are planing full cloud approach
GOOGLE_API_KEY="your-gemini-api-key-here"
GOOGLE_API_KEY1="your-gemini-api-key-1-here"
GOOGLE_API_KEY2="your-gemini-api-key-2-here"
GEMINI_MODEL="gemini-2.5-pro"

# Provider Selection: "gemini" or "ollama"
LLM_PROVIDER="ollama" 

# Ollama Specific Config
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL_NAME="llama3.1:8b"
OLLAMA_JSON_MODEL_NAME="llama3.1:8b"

# Image Generation Provider: "comfyui" or "gemini"
IMAGE_PROVIDER="comfyui"
COMFYUI_BASE_URL="http://localhost:8188"

# TTS Provider Selection: "kokoro" or "gcp"
TTS_PROVIDER="kokoro"
KOKORO_BASE_URL="http://localhost:8880/v1/audio/speech"
KOKORO_VOICE="am_adam"

# LLM Rate Limiting & Cooldown Configuration
LLM_BATCH_SIZE=5
LLM_COOLDOWN_MS=15000
LLM_CALL_DELAY_MS=3000
LLM_MAX_RETRIES=4
